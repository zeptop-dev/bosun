#!/sbin/openrc-run
# bosun node agent (Alpine / OpenRC). Installed by scripts/install.sh.
description="bosun node agent"
command="/usr/local/bin/bosun"
command_args="run -c /etc/bosun/config.yaml"
command_background=false
supervisor=supervise-daemon
respawn_delay=3
respawn_max=0
directory="/var/lib/bosun"
output_log="/var/log/bosun.log"
error_log="/var/log/bosun.log"
rc_ulimit="-n 1048576"

depend() {
	need net
	after firewall
}

start_pre() {
	# 0755, not 0750: the cores run as an unprivileged account
	# (cores.user) and have to traverse this directory to reach their
	# binary under cores/ and their own work dir. At 0750 every core
	# fails to start with "fork/exec …: permission denied". The
	# secrets in here carry their own 0600.
	checkpath -d -m 0755 /var/lib/bosun
}
