#!/bin/sh /etc/rc.common
# bosun OpenWrt monitor service. Installed by scripts/install.sh.
USE_PROCD=1
START=95
STOP=10

start_service() {
	[ -x /usr/local/bin/bosun ] || return 1
	# Validate the persisted mode before procd launches anything.
	[ "$(/usr/local/bin/bosun installer-node-mode /etc/bosun/config.yaml)" = monitor ] || return 1
	mkdir -p /etc/bosun/data
	chmod 0700 /etc/bosun/data
	procd_open_instance
	procd_set_param command /usr/local/bin/bosun run -c /etc/bosun/config.yaml
	# Restart normal self-update exits too; do not turn an update into a stop.
	procd_set_param respawn 3600 5 0
	procd_set_param term_timeout 60
	procd_set_param file /etc/bosun/config.yaml
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
